# Active Image Generation Provider: 'pollinations' | 'huggingface' | 'gemini' | 'local'
# Defaults to 'pollinations'
IMAGE_PROVIDER="pollinations"

# Pollinations.AI API Key
# Optional for basic tiers, required for authenticated high-throughput and FLUX inference
POLLINATIONS_API_KEY=

# Preferred Pollinations Image Generation Model
# Default: flux (FLUX.1 Schnell)
POLLINATIONS_IMAGE_MODEL="flux"

# Hugging Face Access Token with Inference API permission (Optional fallback)
# Create at https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_token_here"

# Preferred Hugging Face Text-to-Image Model
# Default: black-forest-labs/FLUX.1-schnell
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

# GEMINI_API_KEY: Optional. Only used when IMAGE_PROVIDER is set to 'gemini'.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
